PORT=3000

Mongo_Uri=your_mongodb_connection_here

JWT_SECRET=your_jwt_secret_here

MONGO_DNS_SERVERS=your_dns_servers_here

# Optional: set this only if Expo push security is enabled for the EAS project.
# Keep the real value in the backend deployment environment, never in the app.
EXPO_ACCESS_TOKEN=your_expo_access_token_here